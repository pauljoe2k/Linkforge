{
  "info": {
    "name": "Linkforge API",
    "_postman_id": "6f1e2f10-0dd1-4d42-b0e7-9d23c0a11f30",
    "description": "URL shortener with analytics. The Login request automatically stores {{accessToken}} for the other requests. Set {{baseUrl}} at collection level (default http://localhost:8000).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "accessToken", "value": "" },
    { "key": "email", "value": "postman@example.com" },
    { "key": "password", "value": "super-secret-pass-9" },
    { "key": "linkId", "value": "" },
    { "key": "slug", "value": "loadtest" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          }
        },
        {
          "name": "Login (captures token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200 login', () => pm.response.to.have.status(200));",
                  "if (body.access_token) { pm.collectionVariables.set('accessToken', body.access_token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Links",
      "item": [
        {
          "name": "Create link (captures linkId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.id) { pm.collectionVariables.set('linkId', body.id); }",
                  "if (body.slug) { pm.collectionVariables.set('slug', body.slug); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/links",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"target_url\": \"https://example.com/some/long/path\"\n}"
            }
          }
        },
        {
          "name": "List links (paginated)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/links?limit=20&offset=0"
          }
        },
        {
          "name": "Get link",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/links/{{linkId}}"
          }
        },
        {
          "name": "Update link (retarget)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/links/{{linkId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"target_url\": \"https://example.com/updated\"\n}"
            }
          }
        },
        {
          "name": "Delete link",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/links/{{linkId}}"
          }
        }
      ]
    },
    {
      "name": "Redirect",
      "item": [
        {
          "name": "Redirect (public, no auth)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/{{slug}}"
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "Summary",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/links/{{linkId}}/analytics/summary"
          }
        },
        {
          "name": "Daily (date range)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/links/{{linkId}}/analytics/daily?start=2026-10-01&end=2026-10-31"
          }
        },
        {
          "name": "Referrers (top N)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/links/{{linkId}}/analytics/referrers?limit=10"
          }
        }
      ]
    }
  ]
}
